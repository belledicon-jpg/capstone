# Env example for GovServe Backend Server

# Custom SMTP Email Server (for sending actual OTP verification emails to personal user addresses)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=GovServe <your-email@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# SendGrid Email Service (optional alternative)
SENDGRID_API_KEY=
SENDGRID_FROM=

# S3 Storage (optional - if set, avatars will be uploaded to AWS S3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Server port
PORT=4000
