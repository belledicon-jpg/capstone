# Frontend environment variables

# API base URL (optional)
# For local development pointing to a backend on http://localhost:4000, set:
#   VITE_API_BASE=http://localhost:4000
# For production or when the backend is served from the same origin, leave unset
# (requests will go to relative /api/* paths).
VITE_API_BASE=

# Analytics / monitoring (optional)
# VITE_ANALYTICS_KEY=your-key
